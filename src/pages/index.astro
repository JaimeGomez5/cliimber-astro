---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import HomeHero from '../components/HomeHero';
import { VoiceNote } from '../components/VoiceNote';
import { EpisodeCard } from '../components/EpisodeCard';
import { FaqItem } from '../components/FaqItem';
import ContactForm from '../components/ContactForm';

const ldJson = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "ProfessionalService",
      name: "Cliimber",
      url: "https://cliimber.com",
      telephone: "+34609575722",
      areaServed: "ES",
      serviceArea: { "@type": "Country", name: "España" },
      founder: { "@type": "Person", name: "Jaime Gómez" },
      address: { "@type": "PostalAddress", addressLocality: "Madrid", addressCountry: "ES" },
      description: "Desarrollo web a medida, herramientas interactivas, SEO/SEM. Especialización en sector pet.",
      knowsAbout: ["Desarrollo web a medida", "SEO", "AEO", "SEM", "Herramientas interactivas", "Sector pet España"],
      sameAs: ["https://www.linkedin.com/in/jaime-g%C3%B3mez-de-alvar%C3%A9-74baa417a/"],
      logo: {
        "@type": "ImageObject",
        url: "https://cliimber.com/assets/cliimber-logo.png"
      },
      image: "https://cliimber.com/assets/jaime.jpeg",
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: "Servicios Cliimber",
        itemListElement: [
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Desarrollo web a medida" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "SEO y AEO para pymes españolas" } },
          { "@type": "Offer", itemOffered: { "@type": "Service", name: "Herramientas interactivas a medida" } },
        ],
      },
    },
    {
      "@type": "Person",
      name: "Jaime Gómez",
      jobTitle: "Desarrollador web",
      url: "https://cliimber.com",
      description: "Desarrollador web freelance especializado en webs a medida para pymes españolas. Especialización en sector pet. Base en Madrid, trabaja con toda España.",
      knowsAbout: ["Desarrollo web", "SEO técnico", "AEO", "Sector pet", "HTML CSS JavaScript"],
      sameAs: ["https://www.linkedin.com/in/jaime-g%C3%B3mez-de-alvar%C3%A9-74baa417a/"],
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        { "@type": "Question", name: "¿Mi web no me trae clientes, qué puede estar fallando?", acceptedAnswer: { "@type": "Answer", text: "Los problemas más comunes son tres: la web va lenta y Google la penaliza, el copy habla de ti en lugar de hablar del problema de tu cliente, o no hay SEO técnico desde la base. En Cliimber hacemos un diagnóstico antes de proponer nada para identificar exactamente qué está fallando en tu caso." } },
        { "@type": "Question", name: "¿Cuánto cuesta una web con Cliimber?", acceptedAnswer: { "@type": "Answer", text: "El precio se define en la primera conversación según la complejidad del proyecto. Presupuesto cerrado antes de empezar, sin extras sorpresa ni letra pequeña." } },
        { "@type": "Question", name: "¿Qué diferencia hay entre una web a medida y una plantilla?", acceptedAnswer: { "@type": "Answer", text: "Una web a medida está construida desde cero específicamente para tu negocio, sin plantillas que usa todo el mundo, sin piezas prestadas que se rompen solas y sin depender de nadie para hacer cambios. El resultado es una web más rápida, más segura y 100% tuya desde el día 1." } },
        { "@type": "Question", name: "¿Cuánto tarda en hacerse una web?", acceptedAnswer: { "@type": "Answer", text: "Entre 2 y 4 semanas desde que el brief está claro. Sin colas de agencia, sin juniors que no conocen tu proyecto. El que te hace la web es el mismo que habla contigo." } },
        { "@type": "Question", name: "¿Trabajáis con clínicas veterinarias y negocios del sector pet?", acceptedAnswer: { "@type": "Answer", text: "Sí, es la especialización principal. Tenemos casos reales con nutricionistas caninas, marcas de pienso y accesorios para perros. Entendemos el sector, el lenguaje de sus clientes y qué herramientas digitales funcionan en él." } },
        { "@type": "Question", name: "¿Cuánto tarda en posicionar una web nueva en Google?", acceptedAnswer: { "@type": "Answer", text: "Los primeros resultados visibles suelen aparecer en las primeras semanas para búsquedas específicas del nicho. Cuanto antes esté la web técnicamente bien construida, antes empieza Google a rastrearla. Para keywords más competidas el proceso es de varios meses." } },
        { "@type": "Question", name: "¿El código de mi web es mío?", acceptedAnswer: { "@type": "Answer", text: "Sí, desde el día de entrega. El repositorio Git queda a tu nombre, el dominio y el hosting también. Si algún día decides no seguir trabajando con Cliimber, te llevas tu web sin pelear y sin empezar de cero." } },
        { "@type": "Question", name: "¿Qué es el AEO y por qué lo mencionáis?", acceptedAnswer: { "@type": "Answer", text: "AEO es posicionamiento en IAs como ChatGPT, Perplexity o Claude. Cuando alguien le pregunta a una IA que le recomiende un desarrollador web para pymes en España, queremos que Cliimber aparezca en esa respuesta. Para conseguirlo construimos las webs con estructura y contenido que las IAs pueden leer y citar." } },
      ],
    },
  ],
};
---
<BaseLayout
  title="Cliimber, Web a medida que trae clientes | Pymes España 2026"
  description="¿Tu web no vende? Construyo webs a medida sin cuotas mensuales ni intermediarios. El código es tuyo. Especializado en sector pet. Madrid, toda España."
  canonical="https://cliimber.com/"
  ogTitle="Cliimber, Web a medida que trae clientes"
  ogDescription="Webs y herramientas a medida sin cuotas, sin intermediarios. El código es tuyo desde el día uno."
  ogImage="/assets/og-home.png"
  ldJson={ldJson}
>
  <Nav />

  <!-- AEO invisible -->
  <p class="sr-only">
    Cliimber es el servicio de desarrollo web a medida de Jaime Gómez, con base en Madrid y trabajando con pymes de toda España. Construye webs, calculadoras y herramientas interactivas en código puro sin WordPress, especializado en sector pet. El código es del cliente desde el primer día.
  </p>

  <!-- HERO -->
  <HomeHero client:load />

  <!-- REVEAL -->
  <section style="background: var(--azul-claro);" class="py-24">
    <div class="container-x text-center reveal">
      <p class="text-2xl md:text-4xl font-bold leading-tight max-w-4xl mx-auto" style="color: var(--texto-medio);">
        La mayoría te entrega la web y desaparece.
      </p>
      <p class="text-2xl md:text-4xl font-bold leading-tight max-w-4xl mx-auto mt-2" style="color: var(--verde);">
        Yo sigo cuando empieza lo importante: hacer que funcione.
      </p>
    </div>
  </section>

  <!-- DOLOR -->
  <section style="background: var(--azul-oscuro);" class="py-24">
    <div class="container-x">
      <div class="max-w-3xl mb-12 reveal">
        <span class="tag tag-dark mb-4">El problema</span>
        <h2 class="h-section mt-4 mb-4" style="color: #f5f8f9;">Tu web existe. Pero no trabaja.</h2>
        <p class="text-[17px]" style="color: #7a8e96;">
          El 80% de las pymes tienen una web que no les trae ni un cliente al mes. No es mala suerte, es que fue construida para verse bien, no para funcionar.
        </p>
      </div>
      <div class="grid md:grid-cols-3 gap-5">
        <article class="p-7 rounded-2xl border transition-all hover:-translate-y-1 hover:border-[var(--verde)] reveal" style="background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1);">
          <div class="text-sm font-bold mb-3" style="color: var(--verde-claro);">01</div>
          <p class="text-lg font-bold mb-4 leading-snug" style="color: #f5f8f9;">"Pago todos los meses pero no sé muy bien qué están haciendo."</p>
          <div class="w-10 h-0.5 mb-4" style="background: var(--verde);"></div>
          <p class="text-sm leading-relaxed mb-5" style="color: #7a8e96;">Una web sin estrategia es un folleto guardado en el cajón. Y el informe mensual que recibes está lleno de métricas que no se traducen en clientes.</p>
          <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--verde-claro);">→ Webs que convierten</span>
        </article>
        <article class="p-7 rounded-2xl border transition-all hover:-translate-y-1 hover:border-[var(--verde)] reveal" style="background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1);">
          <div class="text-sm font-bold mb-3" style="color: var(--verde-claro);">02</div>
          <p class="text-lg font-bold mb-4 leading-snug" style="color: #f5f8f9;">"Tengo visitas pero no tengo clientes."</p>
          <div class="w-10 h-0.5 mb-4" style="background: var(--verde);"></div>
          <p class="text-sm leading-relaxed mb-5" style="color: #7a8e96;">Tráfico sin conversión es dinero tirado. Si la gente entra y se va sin hacer nada, el problema no es el marketing, es la estructura de la web.</p>
          <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--verde-claro);">→ Herramientas que convierten</span>
        </article>
        <article class="p-7 rounded-2xl border transition-all hover:-translate-y-1 hover:border-[var(--verde)] reveal" style="background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1);">
          <div class="text-sm font-bold mb-3" style="color: var(--verde-claro);">03</div>
          <p class="text-lg font-bold mb-4 leading-snug" style="color: #f5f8f9;">"Dependo de Instagram para vender, y vivo con miedo a que cambie el algoritmo."</p>
          <div class="w-10 h-0.5 mb-4" style="background: var(--verde);"></div>
          <p class="text-sm leading-relaxed mb-5" style="color: #7a8e96;">Vender solo por redes es vivir en una casa prestada. Un día cambia el algoritmo, te cierran la cuenta, y tu facturación cae con ello.</p>
          <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--verde-claro);">→ Tu canal propio</span>
        </article>
      </div>
      <div class="mt-12 max-w-md mx-auto reveal">
        <VoiceNote src="/assets/nota1.m4a" client:visible />
      </div>
    </div>
  </section>

  <!-- DIFERENTE -->
  <section style="background: var(--azul-claro);" class="py-24 border-t">
    <div class="container-x">
      <div class="max-w-3xl mb-12 reveal">
        <h2 class="h-section mb-4">Te vendieron una plantilla. Te dijeron que era a medida.</h2>
        <p class="text-[17px]" style="color: var(--texto-medio);">
          Tu negocio tiene su propia forma. Meterlo en una caja prediseñada es garantizar que nunca encaje del todo.
        </p>
      </div>
      <div class="rounded-2xl overflow-hidden border reveal grid grid-cols-1 sm:grid-cols-2" style="border-color: var(--borde);">
        <div>
          <div class="p-5 font-bold text-sm uppercase tracking-wider" style="background: #e9eef0; color: var(--texto-medio);">Lo que te vendieron</div>
          <div class="p-5 text-sm border-t" style="background: #fff; border-color: var(--borde); color: var(--texto-medio);"><span style="color: var(--granate);" class="font-bold mr-2">✕</span>Plantilla con tu logo, igual que la del competidor de enfrente</div>
          <div class="p-5 text-sm border-t" style="background: #fff; border-color: var(--borde); color: var(--texto-medio);"><span style="color: var(--granate);" class="font-bold mr-2">✕</span>Lento, frágil, y lleno de piezas que se rompen solas</div>
          <div class="p-5 text-sm border-t" style="background: #fff; border-color: var(--borde); color: var(--texto-medio);"><span style="color: var(--granate);" class="font-bold mr-2">✕</span>Te entregan y desaparecen. El próximo email es la factura de renovación</div>
          <div class="p-5 text-sm border-t" style="background: #fff; border-color: var(--borde); color: var(--texto-medio);"><span style="color: var(--granate);" class="font-bold mr-2">✕</span>SEO prometido que nunca llega, añadido al final, sin base técnica real</div>
          <div class="p-5 text-sm border-t" style="background: #fff; border-color: var(--borde); color: var(--texto-medio);"><span style="color: var(--granate);" class="font-bold mr-2">✕</span>Para cambiar un teléfono: 4 días y un ticket de soporte</div>
          <div class="p-5 text-sm border-t" style="background: #fff; border-color: var(--borde); color: var(--texto-medio);"><span style="color: var(--granate);" class="font-bold mr-2">✕</span>El código es de ellos. Si te vas, empiezas de cero</div>
        </div>
        <div class="border-t sm:border-t-0 sm:border-l" style="border-color: var(--borde);">
          <div class="p-5 font-bold text-sm uppercase tracking-wider" style="background: var(--verde); color: var(--texto-claro);">Lo que construyo yo</div>
          <div class="p-5 text-sm border-t" style="background: var(--verde-fondo); border-color: var(--borde); color: var(--texto-oscuro);"><span style="color: var(--verde-claro);" class="font-bold mr-2">✓</span>Construido desde cero para ti, ningún otro negocio tiene lo mismo</div>
          <div class="p-5 text-sm border-t" style="background: var(--verde-fondo); border-color: var(--borde); color: var(--texto-oscuro);"><span style="color: var(--verde-claro);" class="font-bold mr-2">✓</span>Rápido desde el primer día, sin piezas prestadas que fallen</div>
          <div class="p-5 text-sm border-t" style="background: var(--verde-fondo); border-color: var(--borde); color: var(--texto-oscuro);"><span style="color: var(--verde-claro);" class="font-bold mr-2">✓</span>Me quedo cuando empieza lo importante, que funcione y que crezca</div>
          <div class="p-5 text-sm border-t" style="background: var(--verde-fondo); border-color: var(--borde); color: var(--texto-oscuro);"><span style="color: var(--verde-claro);" class="font-bold mr-2">✓</span>SEO integrado desde la estructura, no como parche posterior</div>
          <div class="p-5 text-sm border-t" style="background: var(--verde-fondo); border-color: var(--borde); color: var(--texto-oscuro);"><span style="color: var(--verde-claro);" class="font-bold mr-2">✓</span>Cualquier cambio: me escribes por WhatsApp y está hecho</div>
          <div class="p-5 text-sm border-t" style="background: var(--verde-fondo); border-color: var(--borde); color: var(--texto-oscuro);"><span style="color: var(--verde-claro);" class="font-bold mr-2">✓</span>El código es tuyo desde el día uno. Sin ataduras, sin letra pequeña.</div>
        </div>
      </div>
      <div class="mt-10 p-8 rounded-2xl reveal" style="background: var(--azul-oscuro); color: var(--texto-claro);">
        <p class="text-lg leading-relaxed">
          Una web rápida no es un lujo. Es lo que determina si Google te muestra o te ignora, si el cliente se queda o se va. Cada segundo de carga es dinero que se pierde. Por eso construyo desde el código, no desde una plantilla que alguien diseñó para otro.
        </p>
      </div>
    </div>
  </section>

  <!-- MÉTODO ESCALA -->
  <section style="background: var(--azul-oscuro); color: var(--texto-claro);" class="py-24">
    <div class="container-x">
      <div class="max-w-3xl mb-12 reveal">
        <span class="tag tag-dark">El método</span>
        <h2 class="h-section mt-4 mb-4">Método <span style="color: #a8e063;">ESCALA</span></h2>
        <p class="text-[17px] opacity-85">Antes de escribir una línea de código, ya sé exactamente qué necesita tu negocio.</p>
        <p class="italic mt-4 pl-4 border-l-4" style="border-color: var(--verde-claro);">
          La mayoría construye la web y luego piensa en cómo traer clientes. Yo lo hago al revés.
        </p>
      </div>
      <div class="mt-10 mb-12 max-w-md reveal">
        <VoiceNote src="/assets/nota2.m4a" client:visible />
      </div>
      <ol class="space-y-6 max-w-3xl">
        <li class="flex gap-5 reveal">
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full grid place-items-center font-extrabold text-lg" style="background: var(--verde);">1</div>
            <div class="w-0.5 flex-1 mt-2" style="background: var(--borde-oscuro);"></div>
          </div>
          <div class="pb-6">
            <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--verde-claro);">Fase 1</span>
            <h3 class="text-2xl font-extrabold mb-2 mt-1">Diagnóstico</h3>
            <p class="opacity-85 mb-3">Investigación de mercado y cliente ideal. Entiendo tu negocio antes de proponer nada.</p>
          </div>
        </li>
        <li class="flex gap-5 reveal">
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full grid place-items-center font-extrabold text-lg" style="background: var(--verde);">2</div>
            <div class="w-0.5 flex-1 mt-2" style="background: var(--borde-oscuro);"></div>
          </div>
          <div class="pb-6">
            <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--verde-claro);">Fase 2</span>
            <h3 class="text-2xl font-extrabold mb-2 mt-1">Arquitectura</h3>
            <p class="opacity-85 mb-3">Análisis de herramientas de conversión. Defino qué tiene que hacer cada página y cada elemento.</p>
          </div>
        </li>
        <li class="flex gap-5 reveal">
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full grid place-items-center font-extrabold text-lg" style="background: var(--verde);">3</div>
            <div class="w-0.5 flex-1 mt-2" style="background: var(--borde-oscuro);"></div>
          </div>
          <div class="pb-6">
            <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--verde-claro);">Fase 3</span>
            <h3 class="text-2xl font-extrabold mb-2 mt-1">Construcción</h3>
            <p class="opacity-85 mb-3">Desarrollo a código puro + SEO base. Sin WordPress. Sin plantillas. Velocidad real.</p>
          </div>
        </li>
        <li class="flex gap-5 reveal">
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full grid place-items-center font-extrabold text-lg" style="background: var(--verde);">4</div>
            <div class="w-0.5 flex-1 mt-2" style="background: var(--borde-oscuro);"></div>
          </div>
          <div class="pb-6">
            <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--verde-claro);">Fase 4</span>
            <h3 class="text-2xl font-extrabold mb-2 mt-1">Tráfico</h3>
            <p class="opacity-85 mb-3">SEO, AEO y SEM con ventaja real. La web ya está pensada para captar, solo hay que activarla.</p>
          </div>
        </li>
        <li class="flex gap-5 reveal">
          <div class="flex flex-col items-center">
            <div class="w-12 h-12 rounded-full grid place-items-center font-extrabold text-lg" style="background: var(--verde);">5</div>
          </div>
          <div class="pb-6">
            <span class="text-xs font-bold uppercase tracking-wider" style="color: var(--verde-claro);">Fase 5</span>
            <h3 class="text-2xl font-extrabold mb-2 mt-1">Evolución</h3>
            <p class="opacity-85 mb-3">Growth partner para el largo plazo. La web crece cuando crece el negocio.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- PAQUETES -->
  <section id="paquetes" style="background: var(--azul-claro);" class="py-24">
    <div class="container-x">
      <div class="max-w-3xl mb-12 reveal">
        <span class="tag">Los paquetes</span>
        <h2 class="h-section mt-4 mb-4">¿Hasta dónde quieres llegar?</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-5 items-stretch">
        <!-- ESCALA Web -->
        <div class="p-8 rounded-2xl border-2 relative reveal flex flex-col" style="background: #e8f5f1; color: var(--texto-oscuro); border-color: #0a5f4a;">
          <h3 class="text-2xl font-extrabold mb-2">ESCALA Web</h3>
          <p class="text-[15px] mb-6" style="color: var(--texto-medio);">Para negocios que quieren dejar de depender del boca a boca y de Instagram.</p>
          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex gap-3 text-[15px] leading-snug"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="mt-1 shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="var(--verde)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Diagnóstico de tu negocio y cliente ideal</span></li>
            <li class="flex gap-3 text-[15px] leading-snug"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="mt-1 shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="var(--verde)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Arquitectura de conversión antes de tocar código</span></li>
            <li class="flex gap-3 text-[15px] leading-snug"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="mt-1 shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="var(--verde)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Web a código puro, sin WordPress, sin plantillas</span></li>
            <li class="flex gap-3 text-[15px] leading-snug"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="mt-1 shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="var(--verde)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>SEO técnico integrado desde la estructura</span></li>
            <li class="flex gap-3 text-[15px] leading-snug"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" class="mt-1 shrink-0" aria-hidden="true"><path d="M20 6L9 17l-5-5" stroke="var(--verde)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg><span>Despliegue incluido. El código es tuyo desde el día 1</span></li>
          </ul>
          <a href="/#contacto" class="btn btn-primary w-full mt-auto">Hablemos y te cuento →</a>
        </div>
        <!-- ESCALA Posicionamiento (featured) -->
        <div class="p-8 rounded-2xl border relative reveal flex flex-col" style="background: var(--verde); color: var(--texto-claro); border-color: var(--verde); box-shadow: 0 20px 40px -20px rgba(10,95,74,0.45);">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 text-xs font-bold px-3 py-1 rounded-full whitespace-nowrap" style="background: #a8e063; color: #0d2838;">Más popular</span>
          <h3 class="text-2xl font-extrabold mb-2">ESCALA Posicionamiento</h3>
          <p class="text-[15px] mb-6" style="color: rgba(255,255,255,0.85);">Para negocios que quieren web y que Google y las IAs les recomienden.</p>
          <ul class="space-y-3 mb-8 flex-1">
