  <section id="faq" class="py-24" style="background: var(--azul-oscuro);">
    <div class="container-x grid md:grid-cols-[1fr_1.6fr] gap-12">
      <div class="md:sticky md:top-24 self-start reveal">
        <span class="tag tag-dark mb-4">Preguntas frecuentes</span>
