---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/home/Intro.astro';
import Hero from '../components/home/Hero.astro';
import Problemas from '../components/home/Problemas.astro';
import Webs from '../components/home/Webs.astro';
import SeoGeo from '../components/home/SeoGeo.astro';
import Herramientas from '../components/home/Herramientas.astro';
import CasoLaura from '../components/home/CasoLaura.astro';
import Escala from '../components/home/Escala.astro';
import ComoTrabajo from '../components/home/ComoTrabajo.astro';
import Precios from '../components/home/Precios.astro';
import ParaQuien from '../components/home/ParaQuien.astro';
import SobreMi from '../components/home/SobreMi.astro';
import Faq from '../components/home/Faq.astro';
import Contacto from '../components/home/Contacto.astro';
import { FAQ, INSTAGRAM, LINKEDIN } from '../data/home';
// Estilos de la home insertados en la propia página: así no llegan al blog ni a las legales.
import homeCss from '../styles/home.css?inline';

const SITE = 'https://cliimber.com/';
const precio = (min: number, mes = false) => ({
  '@type': mes ? 'UnitPriceSpecification' : 'PriceSpecification',
  minPrice: min,
  priceCurrency: 'EUR',
  valueAddedTaxIncluded: false,
  ...(mes ? { unitText: 'mes' } : {}),
});

const ldJson = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': SITE + '#cliimber',
      name: 'Cliimber',
      url: SITE,
      telephone: '+34609575722',
      email: 'jaimegomez@cliimber.com',
      areaServed: { '@type': 'Country', name: 'España' },
      address: { '@type': 'PostalAddress', addressLocality: 'Madrid', addressCountry: 'ES' },
      description: 'Webs, SEO local y herramientas a medida para clínicas veterinarias, especialistas y marcas del sector pet en Madrid y toda España.',
      knowsAbout: ['Diseño web a medida', 'SEO local', 'Visibilidad en asistentes de IA', 'Herramientas web a medida', 'Sector pet'],
      founder: { '@id': SITE + '#jaime' },
      logo: { '@type': 'ImageObject', url: 'https://cliimber.com/assets/cliimber-logo.png' },
      image: 'https://cliimber.com/assets/jaime.webp',
      sameAs: [LINKEDIN, INSTAGRAM],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Servicios Cliimber',
        itemListElement: [
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Web de lanzamiento' }, priceSpecification: precio(900) },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'SEO local y visibilidad en IAs' }, priceSpecification: precio(300, true) },
          { '@type': 'Offer', itemOffered: { '@type': 'Service', name: 'Herramienta a medida' }, priceSpecification: precio(400) },
        ],
      },
    },
    {
      '@type': 'Person',
      '@id': SITE + '#jaime',
      name: 'Jaime Gómez de Alvaré',
      jobTitle: 'Desarrollador web',
      url: SITE,
      image: 'https://cliimber.com/assets/jaime.webp',
      worksFor: { '@id': SITE + '#cliimber' },
      description: 'Desarrollador web freelance: webs, SEO local y herramientas a medida para negocios del sector pet. Base en Madrid, trabaja con toda España.',
      knowsAbout: ['Desarrollo web', 'SEO técnico', 'SEO local', 'Sector pet', 'HTML CSS JavaScript'],
      sameAs: [LINKEDIN, INSTAGRAM],
    },
    {
      '@type': 'FAQPage',
      mainEntity: FAQ.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
    },
  ],
};
---
<BaseLayout
  title="Webs, SEO local y herramientas para el sector pet | Cliimber"
  description="Diseño web, SEO local y herramientas a medida para clínicas veterinarias, especialistas y marcas pet. Empieza por una necesidad concreta y crece con Cliimber."
  canonical="https://cliimber.com/"
  ogDescription="Diseño web, SEO local y herramientas a medida para clínicas veterinarias, especialistas y marcas pet."
  ogImage="/assets/og-default.jpg"
  ldJson={ldJson}
>
  <Fragment slot="head">
    <script is:inline>
      // js: hay JavaScript. js-rv: el contenido aparece al hacer scroll (si el script de la home no arranca en 3 s, se ve todo).
      // js-intro: la intro solo se ve en escritorio, en la primera visita de la sesión y nunca con «reducir movimiento».
      // En móvil (menos de 701 px o pantalla táctil) no hay intro: el H1 hace el efecto «caos a orden».
      (function () {
        var d = document.documentElement;
        d.classList.add('js', 'js-rv');
        setTimeout(function () { if (!window.__rv) d.classList.remove('js-rv'); }, 3000);
        var seen = false;
        try { seen = sessionStorage.getItem('cl-intro'); } catch (e) {}
        if (seen || matchMedia('(prefers-reduced-motion: reduce), (max-width: 700px), (pointer: coarse)').matches) return;
        d.classList.add('js-intro');
        // Seguro: si la animación no ha arrancado en 1 s (script lento o bloqueado), se quita y se ve la web
        setTimeout(function () {
          if (!window.__introOn) { d.classList.remove('js-intro'); var i = document.getElementById('intro'); if (i) i.remove(); }
        }, 1000);
      })();
    </script>
    <style is:inline set:html={homeCss}></style>
  </Fragment>

  <Intro />
  <Nav />
  <main>
    <Hero />
    <Problemas />
    <Webs />
    <SeoGeo />
    <Herramientas />
    <CasoLaura />
    <Escala />
    <ComoTrabajo />
    <Precios />
    <ParaQuien />
    <SobreMi />
    <Faq />
    <Contacto />
  </main>
  <Footer home />
</BaseLayout>

<script>
  import '../scripts/home.ts';
</script>
