---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
import Logo from '../../components/Logo.astro';
import Countdown from '../../components/regalo/Countdown';
import RegaloForm from '../../components/regalo/RegaloForm';
import { REGALO } from '../../lib/regalo';

// Landing de la campaña «Tuerca regala 8 horas» (diciembre 2026).
// Los vídeos y la imagen de Tuerca solo se pintan si el archivo existe en /public/regalo/ al hacer el build.
const pub = (f: string) => fs.existsSync(path.join(process.cwd(), 'public', f));
const hayReglas = pub('regalo/reglas.mp4');
const hayPosterReglas = pub('regalo/reglas.jpg');
const hayTuerca = pub('regalo/tuerca.webp');
const hayJuego = pub('regalo/juego-listo.txt'); // crear este archivo vacío el día que el juego esté en /juego/

const SITE = 'https://cliimber.com/';
const canonical = SITE + 'regalo/';

const herramientas = [
  'Formularios que filtran clientes',
  'Avisos automáticos',
  'Recomendadores de producto',
  'Calculadoras de presupuesto',
  'Generadores de presupuestos',
  'Seguimiento de solicitudes',
];

const faq = [
  { q: '¿Es gratis de verdad?', a: 'Sí. Dedico hasta 8 horas en total a tu herramienta: llamada, diseño, desarrollo, pruebas, puesta en marcha y una ronda de ajustes. 0 € de desarrollo. Solo quedan fuera los servicios de terceros que tengan coste, que se hablan antes.' },
  { q: '¿Qué pasa si no me eligen?', a: 'Te escribo para contarte el resultado. Si además has marcado que quieres recibir ideas para tu negocio, te cuento qué haría en tu caso.' },
  { q: '¿Tengo que contratar algo después?', a: 'No. Si la herramienta te sirve y quieres seguir, lo hablamos. Si no, te la quedas y en paz.' },
  { q: '¿Cómo eliges al negocio?', a: 'Con cinco criterios: que el problema sea concreto, que arreglarlo tenga impacto, que quepa en 8 horas, que el negocio se implique y que se pueda medir si ha funcionado. No es un sorteo.' },
  { q: '¿Vale cualquier sector?', a: 'Sí. Trabajo sobre todo con el sector pet, pero esta convocatoria es para cualquier negocio en España con un problema concreto: reformas, academias, clínicas, tiendas, asesorías, hostelería.' },
  { q: '¿Dónde queda la herramienta?', a: 'En tu web, si se puede añadir, o en un alojamiento gratuito a tu nombre. Es tuya. Si necesitara algún servicio de pago de terceros, lo hablamos antes de empezar y decides tú.' },
];
---
<BaseLayout
  title="Construyo gratis una herramienta para tu negocio | Cliimber"
  description={`En vez de Black Friday, construyo gratis una herramienta a medida para un negocio de cualquier sector: formularios, presupuestos, avisos automáticos. Hasta 8 horas de trabajo. Candidaturas ${REGALO.cierreCorto}.`}
  canonical={canonical}
  ogTitle="Construyo gratis una herramienta para tu negocio"
  ogDescription="Elijo un negocio con un problema concreto y le dedico hasta 8 horas a resolverlo. 0 € de desarrollo. Candidaturas hasta el 9 de diciembre."
  hideWhatsApp
  ldJson={{
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: SITE },
      { '@type': 'ListItem', position: 2, name: 'Regalo: 8 horas', item: canonical },
    ],
  }}
>
  <div class="rg">
    <!-- CABECERA -->
    <header class="rg-top">
      <a href="/" aria-label="Cliimber, inicio"><Logo class="rg-logo" /></a>
      <a href="#presentate" class="rg-top-cta">Presentarme</a>
    </header>

    <section class="rg-hero">
      <div class="rg-sparks" aria-hidden="true">
        {Array.from({ length: 18 }).map((_, i) => <i style={`--i:${i}`} />)}
      </div>
      <div class="rg-grid-bg" aria-hidden="true"></div>

      <div class="rg-hero-in">
        <div class="rg-hero-copy">
          <span class="rg-tag">En vez de Black Friday · 8 horas de regalo</span>
          <h1 class="rg-h1">
            Construyo gratis una <span class="rg-hl">herramienta</span> para tu negocio
          </h1>
          <p class="rg-lead">
            Elijo un negocio con un problema concreto y le dedico hasta 8 horas a construirle una herramienta que lo resuelva: un formulario que filtra clientes, un generador de presupuestos, un aviso automático. 0 € de desarrollo. De cualquier sector.
          </p>
          <div class="rg-cd-wrap">
            <span class="rg-cd-title">Candidaturas abiertas, cierran en</span>
            <Countdown client:load />
          </div>
          <div class="rg-ctas">
            <a href="#presentate" class="rg-btn rg-btn-lima rg-btn-big" data-ev="regalo_cta_hero">Presentar mi negocio</a>
            <a href="#que-entra" class="rg-btn rg-btn-ghost">Qué puedo construirte</a>
          </div>
          <p class="rg-micro">1 negocio. 1 herramienta. 0 € de desarrollo. 2 pasos, menos de un minuto.</p>
        </div>

        <div class="rg-clock" aria-hidden="true">
          <svg viewBox="0 0 200 200" class="rg-ring">
            <defs>
              <linearGradient id="rgGrad" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#a8e063" />
                <stop offset="100%" stop-color="#2a9770" />
              </linearGradient>
            </defs>
            <circle cx="100" cy="100" r="86" class="rg-ring-bg" />
            {Array.from({ length: 8 }).map((_, i) => (
              <circle cx="100" cy="100" r="86" class="rg-seg" style={`--s:${i}`} pathLength="80" />
            ))}
          </svg>
          <div class="rg-clock-num">
            <span class="rg-eight" id="rgEight">8</span>
            <span class="rg-h">horas</span>
          </div>
          {hayTuerca && <img src="/regalo/tuerca.webp" alt="" class="rg-tuerca" width="220" height="220" loading="eager" />}
        </div>
      </div>
    </section>

    <!-- CINTA -->
    <div class="rg-marquee" aria-hidden="true">
      <div class="rg-marquee-in">
        {[...herramientas, ...herramientas].map((h) => <span>{h}<b>·</b></span>)}
      </div>
    </div>

    <!-- PROBLEMAS -->
    <section class="rg-sec rg-problemas">
      <div class="rg-in">
        <h2 class="rg-h2 reveal">¿Te suena alguna de estas?</h2>
        <ul class="rg-dolor">
          <li class="reveal">«Cada día respondo las mismas preguntas.»</li>
          <li class="reveal">«Pierdo horas preparando presupuestos.»</li>
          <li class="reveal">«Me llegan solicitudes y tardo demasiado en contestarlas.»</li>
          <li class="reveal">«Los clientes no saben qué elegir y acaban preguntando.»</li>
          <li class="reveal">«Hay tareas que sigo haciendo a mano.»</li>
        </ul>
        <p class="rg-dolor-remate reveal">Puede que no necesites contratar a nadie más. Puede que necesites una herramienta que haga parte de ese trabajo por ti.</p>
      </div>
    </section>

    <!-- QUÉ ENTRA -->
    <section class="rg-sec" id="que-entra">
      <div class="rg-in">
        <span class="rg-tag rg-tag-light">Qué cabe en 8 horas</span>
        <h2 class="rg-h2 reveal">Una herramienta, bien hecha y funcionando</h2>
        <p class="rg-sub reveal">Algunos ejemplos de lo que puedo construirte. Elegimos juntos la que más te haga falta.</p>

        <div class="rg-cards">
          <article class="rg-card reveal">
            <div class="rg-mock rg-mock-form" aria-hidden="true">
              <div class="m-q">¿Qué necesitas?</div>
              <div class="m-opt">Información</div>
              <div class="m-opt m-pick">Presupuesto</div>
              <div class="m-opt">Urgencia</div>
              <div class="m-ok">Solicitud recibida</div>
            </div>
            <h3>Formulario que filtra</h3>
            <p>Pregunta lo justo, se adapta a cada respuesta y te llega ordenado. Se acabó el «hola, quería información».</p>
          </article>

          <article class="rg-card reveal">
            <div class="rg-mock rg-mock-aviso" aria-hidden="true">
              <div class="m-phone">
                <div class="m-notif">
                  <b>Negocio de ejemplo</b>
                  <span>Tu presupuesto está listo. ¿Lo revisamos mañana a las 10:00?</span>
                </div>
              </div>
            </div>
            <h3>Aviso automático</h3>
            <p>Cada solicitud recibe su seguimiento a tiempo: presupuesto, cita, recordatorio, recompra. Sin que tú estés pendiente.</p>
          </article>

          <article class="rg-card reveal">
            <div class="rg-mock rg-mock-reco" aria-hidden="true">
              <div class="m-dots"><i></i><i></i><i></i></div>
              <div class="m-result">
                <span>Te recomendamos</span>
                <b>Plan mensual básico</b>
              </div>
            </div>
            <h3>Recomendador de servicios o productos</h3>
            <p>Tres o cuatro preguntas y el cliente sabe qué le conviene. Lo que le dirías tú en persona, en la web.</p>
          </article>

          <article class="rg-card reveal">
            <div class="rg-mock rg-mock-calc" aria-hidden="true">
              <div class="m-line"><span>Servicio</span><span>Básico</span></div>
              <div class="m-line"><span>Extras</span><span>2</span></div>
              <div class="m-total"><span>Presupuesto</span><b>al momento</b></div>
            </div>
            <h3>Generador de presupuestos</h3>
            <p>El cliente se hace una idea del precio sin esperar a que le contestes. Tú recibes solo a los que encajan.</p>
          </article>
        </div>
        <p class="rg-demo-note">Ejemplos con datos ficticios.</p>
        <p class="rg-sector reveal">Trabajo sobre todo con negocios del sector pet, pero esta convocatoria está abierta a autónomos y empresas de cualquier sector: reformas, academias, clínicas, tiendas, asesorías, hostelería. Lo importante no es a qué te dedicas, sino qué problema se puede resolver.</p>

        <div class="rg-split">
          <div class="rg-video-real reveal">
            <video src="/videos/reel-formulario-web.mp4" poster="/videos/reel-formulario-poster.jpg" muted loop playsinline preload="none" controls data-ev="regalo_video_real"></video>
          </div>
          <div class="rg-split-copy reveal">
            <h3 class="rg-h3">Así es uno de verdad</h3>
            <p>Esto no es una maqueta: es un formulario a medida que construí para un negocio y está funcionando. Es de un sector concreto, pero la misma idea sirve para el tuyo.</p>
            <ul class="rg-list">
              <li><b>Entra, hasta 8 horas en total:</b> llamada para entender el problema, diseño, desarrollo, pruebas, puesta en marcha y una ronda de ajustes. Coste de desarrollo para ti: 0 €.</li>
              <li class="no"><b>No entra:</b> una web completa, una tienda online, conectarlo con tu programa de gestión, hosting, dominios ni licencias.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    {hayReglas && (
      <section class="rg-sec rg-sec-dark" id="reglas">
        <div class="rg-in rg-reglas">
          <h2 class="rg-h2">Las reglas, en un minuto</h2>
          <video src="/regalo/reglas.mp4" poster={hayPosterReglas ? '/regalo/reglas.jpg' : undefined} controls playsinline preload="metadata" class="rg-video-reglas" data-ev="regalo_video_play"></video>
        </div>
      </section>
    )}

    <!-- CÓMO PARTICIPAR -->
    <section class="rg-sec rg-sec-dark" id="como">
      <div class="rg-in">
        <span class="rg-tag">Cómo participar</span>
        <h2 class="rg-h2 reveal">Tres pasos</h2>
        <ol class="rg-pasos">
          <li class="reveal">
            <span class="rg-n">1</span>
            <div>
              <h3>Cuéntame tu problema</h3>
              <p>Con tus palabras. No hace falta que sepas qué herramienta necesitas. Dos pasos, menos de un minuto.</p>
            </div>
          </li>
          <li class="reveal">
            <span class="rg-n">2</span>
            <div>
              <h3>Leo todas las candidaturas</h3>
              <p>Elijo el negocio con los criterios de abajo. No es un sorteo y la decisión es mía.</p>
            </div>
          </li>
          <li class="reveal">
            <span class="rg-n">3</span>
            <div>
              <h3>Antes del {REGALO.cierreTexto}</h3>
              <p>El {REGALO.anuncioTexto} anuncio el negocio elegido en <a href={REGALO.instagramUrl} target="_blank" rel="noopener">{REGALO.instagram}</a>. La herramienta se construye en enero.</p>
            </div>
          </li>
        </ol>

        <div class="rg-criterios reveal">
          <h3 class="rg-h3">Cómo elijo</h3>
          <div class="rg-crit-grid">
            <span>Un problema concreto</span>
            <span>Que arreglarlo tenga impacto</span>
            <span>Que quepa en 8 horas</span>
            <span>Ganas de implicarse</span>
            <span>Que se pueda medir</span>
          </div>
          <p>Todas las candidaturas reciben respuesta con el resultado.</p>
        </div>
      </div>
    </section>

    <!-- FORMULARIO -->
    <section class="rg-sec rg-form-sec" id="presentate">
      <div class="rg-in rg-form-in">
        <div class="rg-form-copy">
          <span class="rg-tag rg-tag-light">Tu candidatura</span>
          <h2 class="rg-h2">Presenta tu negocio</h2>
          <p class="rg-sub">Cuanto más concreto sea el problema, más fácil es que lo elija.</p>
          <div class="rg-form-cd"><Countdown client:load compact /></div>
        </div>
        <RegaloForm client:load />
      </div>
    </section>

    <!-- JUEGO -->
    <section class="rg-sec rg-sec-dark rg-juego">
      <div class="rg-in">
        <span class="rg-tag">Mientras esperas</span>
        {hayJuego ? (
          <>
            <h2 class="rg-h2">Juega a la semana de Tuerca</h2>
            <p class="rg-sub rg-sub-dark">Tuerca tiene que entregar una herramienta antes del viernes. ¿Le ayudas?</p>
            <a class="rg-btn rg-btn-lima rg-btn-big" href="/juego/" data-ev="regalo_ir_juego">Jugar</a>
          </>
        ) : (
          <>
            <h2 class="rg-h2">Tuerca está terminando un juego</h2>
            <p class="rg-sub rg-sub-dark">Muy pronto, aquí. Mientras tanto, el formulario está abierto.</p>
          </>
        )}
      </div>
    </section>

    <!-- FAQ -->
    <section class="rg-sec" id="preguntas">
      <div class="rg-in rg-faq">
        <h2 class="rg-h2">Preguntas</h2>
        {faq.map((f) => (
          <details class="rg-q">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
        <p class="rg-bases-link">Todas las condiciones, en las <a href="/regalo/bases/">bases</a>.</p>
      </div>
    </section>

    <!-- BARRA FIJA (móvil) -->
    <div class="rg-sticky" id="rgSticky">
      <div class="rg-sticky-cd"><Countdown client:idle compact /></div>
      <a href="#presentate" class="rg-btn rg-btn-lima" data-ev="regalo_cta_sticky">Presentar mi negocio</a>
    </div>
  </div>

  <Footer />

  <script>
    import { evento } from '../../lib/regalo';

    evento('regalo_visita');

    // Siempre empieza arriba, salvo que el enlace lleve un ancla (#presentate, #como...).
    if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    if (!location.hash) window.scrollTo(0, 0);

    // Clics con data-ev → evento de Clarity.
    document.querySelectorAll<HTMLElement>('[data-ev]').forEach((el) => {
      const name = el.dataset.ev!;
      el.addEventListener(el.tagName === 'VIDEO' ? 'play' : 'click', () => evento(name), { once: el.tagName === 'VIDEO' });
    });

    // El vídeo real se reproduce solo cuando se ve (sin cargar nada antes).
    const real = document.querySelector<HTMLVideoElement>('.rg-video-real video');
    if (real && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => {
          if (e.isIntersecting) { real.play().catch(() => {}); } else { real.pause(); }
        });
      }, { threshold: 0.5 });
      io.observe(real);
    }

    // Barra fija: aparece al pasar la cabecera y se esconde cuando el formulario está en pantalla.
    const sticky = document.getElementById('rgSticky');
    const hero = document.querySelector('.rg-hero');
    const form = document.getElementById('presentate');
    if (sticky && hero && form && 'IntersectionObserver' in window) {
      let pastHero = false;
      let formVisible = false;
      const paint = () => sticky.classList.toggle('show', pastHero && !formVisible);
      new IntersectionObserver(([e]) => { pastHero = !e.isIntersecting; paint(); }, { threshold: 0 }).observe(hero);
      new IntersectionObserver(([e]) => { formVisible = e.isIntersecting; paint(); }, { threshold: 0.15 }).observe(form);
    }

    // El 8 cuenta desde 0 mientras se llena el reloj.
    const eight = document.getElementById('rgEight');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (eight && !reduce) {
      let n = 0;
      eight.textContent = '0';
      const t = window.setInterval(() => {
        n += 1;
        eight.textContent = String(n);
        if (n >= 8) window.clearInterval(t);
      }, 230);
    }
  </script>
</BaseLayout>

<style is:global>
  .rg { --navy: #0b2433; --navy2: #0f3347; --lima: #a8e063; --verde: #2a9770; --verde-o: #0a5f4a; background: #fff; overflow-x: clip; }
  .rg a { color: inherit; }
  .rg-in { max-width: 1120px; margin-inline: auto; padding-inline: 1.25rem; }

  /* Cabecera */
  .rg-top { position: absolute; inset: 0 0 auto 0; z-index: 5; display: flex; align-items: center; justify-content: space-between; padding: 1rem 1.25rem; max-width: 1120px; margin-inline: auto; color: #fff; }
  .rg-logo { font-size: 1.35rem; }
  .rg-top-cta { font-weight: 700; font-size: 0.9rem; padding: 0.55rem 1rem; border-radius: 999px; border: 1px solid rgba(255,255,255,0.25); text-decoration: none; }
  .rg-top-cta:hover { border-color: var(--lima); color: var(--lima); }

  /* Botones */
  .rg-btn { display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; min-height: 50px; padding: 0.85rem 1.5rem; border-radius: 999px; font-weight: 800; text-decoration: none; border: 0; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease; font-size: 1rem; }
  .rg-btn-lima { background: var(--lima); color: #0b2433 !important; box-shadow: 0 10px 30px -10px rgba(168,224,99,0.8); }
  .rg-btn-lima:hover { transform: translateY(-2px); box-shadow: 0 16px 40px -12px rgba(168,224,99,0.95); }
  .rg-btn-ghost { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.3); }
  .rg-btn-ghost:hover { border-color: var(--lima); color: var(--lima); }
  .rg-btn-big { min-height: 58px; font-size: 1.08rem; padding-inline: 2rem; }
  .rg-btn-full { width: 100%; }
  .rg-btn[disabled] { opacity: 0.6; cursor: wait; }
  .rg-btn-lima:not([disabled]) { animation: rgPulse 2.6s ease-in-out infinite; }
  @keyframes rgPulse { 0%,100% { box-shadow: 0 10px 30px -10px rgba(168,224,99,0.7); } 50% { box-shadow: 0 10px 40px -4px rgba(168,224,99,0.95); } }

  .rg-tag { display: inline-block; font-size: 0.74rem; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; color: var(--lima); background: rgba(168,224,99,0.12); border: 1px solid rgba(168,224,99,0.3); padding: 0.4rem 0.85rem; border-radius: 999px; }
  .rg-tag-light { color: var(--verde-o); background: #e8f5f1; border-color: #cde9df; }
  .rg-micro { font-size: 0.85rem; opacity: 0.7; margin-top: 0.75rem; }

  /* Hero */
  .rg-hero { position: relative; min-height: 100svh; display: flex; align-items: center; color: #f5f8f9; background: radial-gradient(1200px 600px at 80% 10%, rgba(42,151,112,0.35), transparent 60%), radial-gradient(900px 500px at 0% 100%, rgba(168,224,99,0.14), transparent 60%), linear-gradient(160deg, #081b26 0%, #0f3347 60%, #0b2433 100%); padding: 6.5rem 0 4rem; overflow: hidden; }
  .rg-grid-bg { position: absolute; inset: 0; background-image: linear-gradient(rgba(255,255,255,0.045) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.045) 1px, transparent 1px); background-size: 44px 44px; mask-image: radial-gradient(ellipse at center, #000 30%, transparent 75%); animation: rgGrid 20s linear infinite; }
  @keyframes rgGrid { to { background-position: 44px 44px; } }
  .rg-sparks i { position: absolute; bottom: -10px; left: calc(var(--i) * 5.6%); width: 4px; height: 4px; border-radius: 50%; background: var(--lima); box-shadow: 0 0 10px 2px rgba(168,224,99,0.7); opacity: 0; animation: rgSpark 7s linear infinite; animation-delay: calc(var(--i) * -0.41s); }
  .rg-sparks i:nth-child(3n) { background: #fff; width: 3px; height: 3px; }
  @keyframes rgSpark { 0% { transform: translateY(0) scale(1); opacity: 0; } 10% { opacity: 1; } 80% { opacity: 0.6; } 100% { transform: translateY(-105svh) translateX(30px) scale(0.4); opacity: 0; } }

  .rg-hero-in { position: relative; z-index: 2; max-width: 1120px; margin-inline: auto; padding-inline: 1.25rem; display: grid; gap: 2.5rem; align-items: center; width: 100%; }
  @media (min-width: 900px) { .rg-hero-in { grid-template-columns: 1.15fr 0.85fr; } }
  .rg-h1 { font-size: clamp(2.2rem, 7.5vw, 4.3rem); font-weight: 800; line-height: 1.02; letter-spacing: -0.035em; margin: 1rem 0 1.1rem; }
  .rg-hl { color: var(--lima); position: relative; white-space: nowrap; text-shadow: 0 0 40px rgba(168,224,99,0.45); }
  .rg-hl::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0.06em; height: 0.14em; background: var(--lima); border-radius: 4px; transform-origin: left; transform: scaleX(0); animation: rgUnder 0.9s 0.5s cubic-bezier(.2,.8,.2,1) forwards; opacity: 0.55; }
  @keyframes rgUnder { to { transform: scaleX(1); } }
  .rg-lead { font-size: clamp(1.05rem, 2.6vw, 1.25rem); line-height: 1.55; color: rgba(245,248,249,0.82); max-width: 36rem; }
  .rg-hero-copy > * { animation: rgIn 0.8s cubic-bezier(.2,.8,.2,1) both; }
  .rg-hero-copy > *:nth-child(2) { animation-delay: 0.08s; } .rg-hero-copy > *:nth-child(3) { animation-delay: 0.16s; } .rg-hero-copy > *:nth-child(4) { animation-delay: 0.24s; } .rg-hero-copy > *:nth-child(5) { animation-delay: 0.32s; } .rg-hero-copy > *:nth-child(6) { animation-delay: 0.4s; }
