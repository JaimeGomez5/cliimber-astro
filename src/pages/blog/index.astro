---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });

const ldJson = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://cliimber.com/" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://cliimber.com/blog/" },
  ],
};
---
<BaseLayout
  title="Blog | Cliimber, diagnósticos honestos sobre tu web"
  description="Diagnósticos sobre por qué tu web no trae clientes, precios reales de una web a medida y decisiones honestas para pymes españolas. Sin postureo."
  canonical="https://cliimber.com/blog/"
  ogTitle="Blog de Cliimber"
  ogDescription="Diagnósticos honestos sobre webs, precios y decisiones para pymes."
  ldJson={ldJson}
>
  <Nav />

  <!-- HERO -->
  <section style="background: var(--azul-oscuro); color: var(--texto-claro);" class="pt-28 pb-20">
    <div class="container-x max-w-3xl">
      <span class="tag tag-dark mb-4 reveal">Blog · Cliimber</span>
      <h1 class="h-display mt-4 mb-5 reveal">Lo que nadie te cuenta antes de pagar una web.</h1>
      <p class="text-lg opacity-85 reveal">
        Diagnósticos, precios reales y decisiones honestas para pymes que quieren una web que trabaje, no que solo se vea bien.
      </p>
    </div>
  </section>

  <!-- LISTADO -->
  <section style="background: var(--background);" class="py-16">
    <div class="container-x max-w-3xl">
      <ul class="flex flex-col">
        {posts.map((post) => (
          <li class="border-b py-10 first:pt-0 last:border-b-0 reveal" style="border-color: var(--borde);">
            <a
              href={`/blog/${post.id}`}
              class={`group block ${post.data.image ? 'md:grid md:grid-cols-[240px_1fr] md:gap-6 md:items-center' : ''}`}
            >
              {post.data.image && (
                <img
                  src={post.data.image}
                  alt={post.data.title}
                  class="w-full rounded-xl object-cover aspect-[680/320] mb-4 md:mb-0"
                />
              )}
              <div>
                <div class="flex flex-wrap items-center gap-3 mb-3">
                  <span class="tag">{post.data.cluster}</span>
                  <span class="text-xs uppercase tracking-wider" style="color: var(--texto-apagado);">
                    {dateFormatter.format(post.data.date)}
                  </span>
                </div>
                <h2
                  class="text-2xl md:text-3xl font-extrabold mb-3 transition-colors group-hover:text-[var(--verde)]"
                  style="color: var(--texto-oscuro); letter-spacing: -0.02em;"
                >
                  {post.data.title}
                </h2>
                <p class="text-[16px] mb-3" style="color: var(--texto-medio);">{post.data.description}</p>
                <span class="text-sm font-bold" style="color: var(--verde);">Leer artículo →</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Footer />
</BaseLayout>
